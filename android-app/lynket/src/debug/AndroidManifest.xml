<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug build only: test hooks for the device checks. Each one is guarded by the DUMP
  permission, which the adb shell holds and other apps do not.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <application>
    <!-- Writes both settings stores and the history to files/debug-dump/ for `adb shell am broadcast -n`. -->
    <receiver
      android:name="arun.com.chromer.debug.StoreDumpReceiver"
      android:exported="true"
      android:permission="android.permission.DUMP" />

    <!-- Reads and posts the bubble notifications for the overflow device check, with
         `adb shell am broadcast -n`. -->
    <receiver
      android:name="arun.com.chromer.debug.BubbleProbeReceiver"
      android:exported="true"
      android:permission="android.permission.DUMP" />

    <!-- The legacy History screen, startable with `adb shell am start -n` for the history check
         after an update, when no link can be opened. -->
    <activity
      android:name="arun.com.chromer.history.HistoryActivity"
      android:exported="true"
      android:permission="android.permission.DUMP"
      tools:node="merge" />

    <!-- The web heads service, startable with `adb shell am start-foreground-service -n` for the
         device check of a link that reaches the service with the overlay permission off, as when
         Android takes the permission away between the bubble check and the service start. -->
    <service
      android:name="arun.com.chromer.bubbles.webheads.WebHeadService"
      android:exported="true"
      android:permission="android.permission.DUMP"
      tools:node="merge"
      tools:replace="android:exported" />
  </application>
</manifest>
