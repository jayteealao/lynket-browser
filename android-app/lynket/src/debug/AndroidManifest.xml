<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug build only: test hooks for the device checks. Each one is guarded by the DUMP
  permission, which the adb shell holds and other apps do not.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <application>
    <!-- Writes both settings stores and the history to files/debug-dump/ for `adb shell am broadcast -n`. -->
    <receiver
      android:name="arun.com.chromer.debug.StoreDumpReceiver"
      android:exported="true"
      android:permission="android.permission.DUMP" />

    <!-- The legacy History screen, startable with `adb shell am start -n` for the history check
         after an update, when no link can be opened. -->
    <activity
      android:name="arun.com.chromer.history.HistoryActivity"
      android:exported="true"
      android:permission="android.permission.DUMP"
      tools:node="merge" />
  </application>
</manifest>
