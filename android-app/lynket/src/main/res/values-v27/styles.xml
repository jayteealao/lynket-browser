<resources>
  <!-- From API 27 the app theme has a white navigation bar with dark icons (see values/styles.xml). -->

  <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:colorPrimary">@color/colorPrimary</item>
    <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="android:colorAccent">@color/colorAccent</item>
    <item name="android:colorControlHighlight">@color/colorAccentLighter</item>
    <item name="android:colorButtonNormal">#FFD6D7D7</item>
    <item name="android:navigationBarColor">@android:color/white</item>
    <item name="android:windowLightNavigationBar">true</item>
  </style>

  <style name="AppTheme.ActionBar" parent="android:Theme.Material.Light.DarkActionBar">
    <item name="android:actionBarTheme">@style/ThemeOverlay.Lynket.ActionBar</item>
    <item name="android:colorPrimary">@color/colorPrimary</item>
    <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="android:colorAccent">@color/colorAccent</item>
    <item name="android:colorControlHighlight">@color/colorAccentLighter</item>
    <item name="android:colorButtonNormal">#FFD6D7D7</item>
    <item name="android:navigationBarColor">@android:color/white</item>
    <item name="android:windowLightNavigationBar">true</item>
  </style>
</resources>
